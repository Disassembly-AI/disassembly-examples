// Jenkins — disassembly scan. DISASSEMBLY_API_KEY as a credential (secret text).
pipeline {
  agent any
  environment {
    DISASSEMBLY_API_KEY = credentials('disassembly-api-key')
    SCAN_TARGET = 'https://staging.example.com'
  }
  triggers { cron('H 6 * * 1') }
  stages {
    stage('scan') {
      steps {
        sh '''
          docker run --rm -e DISASSEMBLY_API_KEY \
            ghcr.io/disassembly-ai/toolkit:latest \
            scan "$SCAN_TARGET" --ci > report.sarif
        '''
        archiveArtifacts artifacts: 'report.sarif'
      }
    }
  }
}
